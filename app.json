{
  "expo": {
    "name": "Cooked",
    "slug": "cooked",
    "scheme": "cooked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/alumni-sans/600SemiBold/AlumniSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/alumni-sans/700Bold/AlumniSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/albert-sans/400Regular/AlbertSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/albert-sans/500Medium/AlbertSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/albert-sans/600SemiBold/AlbertSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/albert-sans/700Bold/AlbertSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/caveat/400Regular/Caveat_400Regular.ttf",
            "./node_modules/@expo-google-fonts/caveat/500Medium/Caveat_500Medium.ttf",
            "./node_modules/@expo-google-fonts/caveat/700Bold/Caveat_700Bold.ttf"
          ]
        }
      ],
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Cooked uses the camera to scan your receipts and what’s in your kitchen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cooked reads the receipt photos and screenshots you pick.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-asset"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
