{
  "expo": {
    "name": "Cooked",
    "slug": "cooked",
    "scheme": "cooked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kylet.cooked",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kylet.cooked",
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf",
            "./node_modules/@expo-google-fonts/lexend/500Medium/Lexend_500Medium.ttf",
            "./node_modules/@expo-google-fonts/lexend/600SemiBold/Lexend_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/lexend/700Bold/Lexend_700Bold.ttf",
            "./node_modules/@expo-google-fonts/caveat/400Regular/Caveat_400Regular.ttf",
            "./node_modules/@expo-google-fonts/caveat/500Medium/Caveat_500Medium.ttf",
            "./node_modules/@expo-google-fonts/caveat/600SemiBold/Caveat_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/caveat/700Bold/Caveat_700Bold.ttf"
          ]
        }
      ],
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Cooked uses the camera to scan your receipts and what’s in your kitchen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cooked reads the receipt photos and screenshots you pick.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-asset",
      "./plugins/with-scene-lifecycle"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c20b8b4-580a-4b98-870c-aa47a2b05063"
      }
    },
    "owner": "kyletoan",
    "updates": {
      "url": "https://u.expo.dev/1c20b8b4-580a-4b98-870c-aa47a2b05063"
    }
  }
}
